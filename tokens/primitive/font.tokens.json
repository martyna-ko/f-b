{
  "font": {
    "family": {
      "$type": "fontFamily",
      "josefin-sans": {
        "$value": ["Josefin Sans", "Futura", "Century Gothic", "sans-serif"],
        "$description": "Logo font. Free (SIL Open Font License)."
      },
      "dm-sans": {
        "$value": ["DM Sans", "system-ui", "-apple-system", "Segoe UI", "sans-serif"],
        "$description": "Body font. Free (SIL Open Font License)."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale based on 16px with a 1.25 ratio, rounded to whole pixels.",
      "100": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "12px"
      },
      "200": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "14px"
      },
      "300": {
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16px — base"
      },
      "400": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "20px"
      },
      "500": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        },
        "$description": "24px"
      },
      "600": {
        "$value": {
          "value": 2,
          "unit": "rem"
        },
        "$description": "32px"
      },
      "700": {
        "$value": {
          "value": 2.5,
          "unit": "rem"
        },
        "$description": "40px"
      },
      "800": {
        "$value": {
          "value": 3.5,
          "unit": "rem"
        },
        "$description": "56px"
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.15,
        "$description": "Large headings"
      },
      "snug": {
        "$value": 1.3,
        "$description": "Small headings, UI labels"
      },
      "normal": {
        "$value": 1.55,
        "$description": "Body text"
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": {
        "$value": {
          "value": 0,
          "unit": "rem"
        }
      },
      "wide": {
        "$value": {
          "value": 0.08,
          "unit": "rem"
        },
        "$description": "Uppercase labels"
      },
      "logo": {
        "$value": {
          "value": 0.3,
          "unit": "rem"
        },
        "$description": "Wide tracking echoing the BALANS wordmark — use for short uppercase headings only"
      }
    }
  }
}
