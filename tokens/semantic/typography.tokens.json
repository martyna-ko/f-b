      "heading": {
        "$type": "fontFamily",
        "$value": "{font.family.josefin-sans}",
        "$description": "All headings."
      },
      "body": {
        "$type": "fontFamily",
        "$value": "{font.family.dm-sans}",
        "$description": "Body text, UI labels, buttons."
      }
    }
  },
  "text": {
