    "body": {
      "lg": {
        "$type": "dimension",
        "$value": "{font.size.400}",
        "$description": "Lead paragraph."
      },
      "md": {
        "$type": "dimension",
        "$value": "{font.size.300}",
        "$description": "Default body text."
